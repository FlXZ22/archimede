{
  "name": "archimede-focus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.js --host 127.0.0.1",
    "build": "node scripts/build-public.mjs && vite build --config vite.config.js",
    "preview": "vite preview --config vite.config.js --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build && cargo test --locked",
    "test:e2e": "node tests/browser.cjs",
    "format": "prettier --write frontend/src scripts/build-public.mjs tests package.json vite.config.js vercel.json README.md && cargo fmt",
    "test:analytics": "node tests/analytics.cjs",
    "test:runtime": "node tests/runtime.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "prettier": "^3.10.0",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": "22.x"
  }
}
